{
  "name": "presto",
  "private": true,
  "version": "0.4.4",
  "type": "module",
  "scripts": {
    "tauri": "tauri",
    "dev": "tauri dev",
    "build": "tauri build",
    "build-themes": "node build-themes.js",
    "prebuild": "npm run build-themes",
    "predev": "npm run build-themes",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "e2e:install": "playwright install --with-deps chromium",
    "validate": "npm run typecheck && npm run lint && npm test && npm run test:e2e"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.49.0",
    "@tauri-apps/cli": "^2.11.1",
    "eslint": "^9.39.4",
    "globals": "^15.15.0",
    "happy-dom": "^20.9.0",
    "prettier": "^3.8.3",
    "typescript": "^5.9.3",
    "vite": "^5.4.0",
    "vitest": "^4.1.5"
  },
  "dependencies": {
    "@aptabase/tauri": "^0.4.1",
    "@tauri-apps/api": "2.6.0",
    "@tauri-apps/plugin-dialog": "^2.2.2",
    "@tauri-apps/plugin-log": "^2",
    "@tauri-apps/plugin-notification": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "^2",
    "@tauri-apps/plugin-updater": "2.8.1",
    "remixicon": "^4.9.1",
    "xlsx": "^0.18.5"
  }
}
